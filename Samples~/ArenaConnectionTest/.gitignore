/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Ignore everything in ProjectSettings
/[Pp]roject[Ss]ettings/*

# Also ignore packages-lock so we always pull the latest packages
/[Pp]ackages/packages-lock.json

# MemoryCaptures can get excessive in size.
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Ignore all Assets EXCEPT our explicit sample code directories
/[Aa]ssets/*
!/[Aa]ssets/Runtime/
!/[Aa]ssets/Runtime.meta
!/[Aa]ssets/Editor/
!/[Aa]ssets/Editor.meta
!/[Aa]ssets/Scenes/
!/[Aa]ssets/Scenes.meta

# Visual Studio cache directory
.vs/
.vsconfig
.vscode/
.idea/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Builds
*.apk
*.aab
*.unitypackage
*.app
